{
  "name": "multarchive-desktop",
  "productName": "Multarchive",
  "version": "1.0.0",
  "description": "Мультархив — энциклопедия классической анимации",
  "author": "SatoNistOne",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:client": "npm --prefix ../client run build",
    "start": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder --linux AppImage",
    "pack": "npm run build:client && electron-builder --dir",
    "dist:win": "npm run build:client && electron-builder --win portable"
  },
  "build": {
    "appId": "ru.multarchive.desktop",
    "productName": "Multarchive",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "renderer"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller": false
  }
}
